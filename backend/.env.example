# ==============================================================================
# FSM Master Core Environment Template
# Note: ZERO vendor or client secrets are hardcoded. Provide values per deployment.
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Standard PostgreSQL 15+ with PostGIS)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fsm_core

# Application Security & Token Lifecycle
JWT_SECRET=generate-a-strong-random-64-character-hex-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dynamic Table Registry (Client-Specific Table Mappings)
# In the Master Core, table names are dynamically loaded. Configure per client.
TABLE_EMPLOYEES=employees
TABLE_REFRESH_TOKENS=refresh_tokens
TABLE_OFFICE_LOCATIONS=office_locations
TABLE_ATTENDANCE=attendance
TABLE_BREAKS=breaks
TABLE_LEAVE_BALANCES=leave_balances
TABLE_LEAVE_REQUESTS=leave_requests
TABLE_FIELD_SESSIONS=field_sessions
TABLE_FIELD_VISITS=field_visits
TABLE_TASKS=tasks
TABLE_AUDIT_LOG=audit_log
TABLE_EXPENSES=expenses
TABLE_ANALYTICS_DAILY_SUMMARY=analytics_daily_summary
TABLE_LEADS=leads

# Client Setup Wizard / Modular Feature Flags
# Controls which API routers and features are mounted for this client
FEATURE_ATTENDANCE=true
FEATURE_FIELD_VISITS=true
FEATURE_LEAVES=true
FEATURE_TASKS=true
FEATURE_EXPENSES=false
FEATURE_ANALYTICS=false

# Geofence & Anti-Fraud Tolerances
DEFAULT_GEOFENCE_RADIUS_METERS=150
MAX_ACCURACY_THRESHOLD_METERS=100
MAX_ALLOWED_SPEED_KMH=140

# Server & CORS
APP_ENV=development
APP_NAME=FSM Core Platform
DEBUG=True
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
